{
  "name": "venn-grid",
  "version": "2.2.0",
  "description": "Grid-based Venn diagram visualization library for game sets",
  "main": "dist/venn-grid.min.js",
  "scripts": {
    "dev": "cp src/venn-grid.js dist/venn-grid.js",
    "build": "terser src/venn-grid.js -o dist/venn-grid.min.js --compress --mangle --comments false",
    "watch": "nodemon --watch src --exec 'npm run dev'"
  },
  "devDependencies": {
    "terser": "^5.16.0",
    "nodemon": "^2.0.20"
  },
  "keywords": ["venn", "diagram", "visualization", "grid", "canvas", "games", "django"],
  "author": "VennGrid Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/venn-grid"
  }
}

